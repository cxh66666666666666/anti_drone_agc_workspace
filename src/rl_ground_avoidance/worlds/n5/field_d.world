<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ground_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 差速小车 -->
    <include>
      <uri>model://ground_car</uri>
      <name>ground_car</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 路障杆（0.3×0.3×3 m），依次位于参考直线 +x 上 -->

    <model name="pole_1">
      <static>true</static>
      <pose>5.0 0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_2">
      <static>true</static>
      <pose>9.0 -0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_3">
      <static>true</static>
      <pose>13.0 0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>0 0.6 1 1</ambient><diffuse>0 0.6 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_4">
      <static>true</static>
      <pose>17.0 -0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>0.6 0.2 1 1</ambient><diffuse>0.6 0.2 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_5">
      <static>true</static>
      <pose>21.0 0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
