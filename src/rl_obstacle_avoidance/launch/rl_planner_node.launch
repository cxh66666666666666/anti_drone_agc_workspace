<launch>
    <!-- 规则避障规划节点 — 参数从 rule_avoidance.yaml 加载 -->
    <node pkg="rl_obstacle_avoidance"
          type="rl_planner_node.py"
          name="rl_planner_node"
          output="screen">
        <rosparam file="$(find rl_obstacle_avoidance)/config/rule_avoidance.yaml"/>
    </node>
</launch>
