<?xml version="1.0" ?>
<!--
  agc_world —— 空地协同 run 的唯一世界（M0 接口契约 v1.1）

  本 world 由 air_ground_core/launch/agc_collab.launch 通过 px4/mavros_posix_sitl.launch
  的 world 参数加载，是协同 run 的唯一 gzserver 世界：同一世界内含本方无人机 iris
  （PX4 自动 spawn）、地面车 agc_car、目标 intruder_uav 与两个静态障碍。

  重要约定：
    * 本文件内的障碍（pole_1 / pole_2）必须与 config/scenario_flat.yaml 的 obstacles
      完全一致（名称、pose、size）。改动任一者都要同步修改另一者，并重新记录场景哈希
      （scenario_file 内容哈希写入 run 日志），否则几何净空/成功判据会与实际世界不符。
    * physics 块逐字继承 PX4 empty.world（max_step_size=0.004、real_time_update_rate=250），
      修改会改变仿真步长与 /clock 行为，须重新标定。
    * 地面车与目标模型不挂任何驱动插件，运行期位姿分别由 ground_drive_adapter /
      intruder_driver 通过 Gazebo set_model_state 写入。
-->
<sdf version="1.5">
  <world name="agc_world">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <!-- 地面车 agc_car：pose 取自 scenario_flat.yaml 的 car_start = [-4 -3 0.11 0]。
         必须与无人机 spawn 点 (0,0) 保持间距，否则两模型初始碰撞会干扰 PX4 EKF。 -->
    <include>
      <uri>model://agc_car</uri>
      <name>agc_car</name>
      <pose>-4 -3 0.11 0 0 0</pose>
    </include>

    <!-- 目标 intruder_uav：pose 取自 scenario_flat.yaml 的 target_start = [6.5 2.5 2.0 0] -->
    <include>
      <uri>model://intruder_uav</uri>
      <name>intruder_uav</name>
      <pose>6.5 2.5 2.0 0 0 0</pose>
    </include>

    <!-- 静态障碍 pole_1：与 config/scenario_flat.yaml obstacles 一致 -->
    <model name="pole_1">
      <static>true</static>
      <pose>2.5 0.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态障碍 pole_2：与 config/scenario_flat.yaml obstacles 一致 -->
    <model name="pole_2">
      <static>true</static>
      <pose>4.5 1.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 3</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>