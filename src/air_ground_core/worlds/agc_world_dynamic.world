<?xml version="1.0" ?>
<!--
  agc_world_dynamic —— 空地协同 run 的热切换世界（M0 接口契约 v1.2）

  本 world 由 air_ground_core/launch/agc_collab.launch 通过 px4/mavros_posix_sitl.launch
  的 world 参数加载，是协同 run 的唯一 gzserver 世界：同一世界内含本方无人机 iris
  （PX4 自动 spawn）、地面车 agc_car、目标 intruder_uav。

  与 agc_world.world 逐字一致，唯一差别：删除两个固定静态障碍 model。障碍改由
  scenario_reset 在 /agc/scenario/dynamic_obstacles=true 时按场景 obstacles 用
  /gazebo/spawn_sdf_model 动态生成（回合间「删旧障碍→放新障碍」），实现一次启动、
  场景间热切换，避免每回合重启整套栈。

  重要约定：
    * 本文件不含固定障碍；动态障碍的 name/pose/size 必须与当前 scenario 的 obstacles
      完全一致，否则几何净空/成功判据会与实际世界不符（scenario_file 内容哈希写入 run 日志）。
    * physics 块逐字继承 PX4 empty.world（max_step_size=0.004、real_time_update_rate=250），
      修改会改变仿真步长与 /clock 行为，须重新标定。
    * 地面车与目标模型不挂任何驱动插件，运行期位姿分别由 ground_drive_adapter /
      intruder_driver 通过 Gazebo set_model_state 写入。
-->
<sdf version="1.5">
  <world name="agc_world">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <!-- 地面车 agc_car：pose 取自 scenario_flat.yaml 的 car_start = [-4 -3 0.11 0]。
         必须与无人机 spawn 点 (0,0) 保持间距，否则两模型初始碰撞会干扰 PX4 EKF。 -->
    <include>
      <uri>model://agc_car</uri>
      <name>agc_car</name>
      <pose>-4 -3 0.11 0 0 0</pose>
    </include>

    <!-- 目标 intruder_uav：pose 取自 scenario_flat.yaml 的 target_start = [6.5 2.5 2.0 0] -->
    <include>
      <uri>model://intruder_uav</uri>
      <name>intruder_uav</name>
      <pose>6.5 2.5 2.0 0 0 0</pose>
    </include>
  </world>
</sdf>